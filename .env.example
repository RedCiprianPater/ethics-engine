# Ethics Engine API Configuration

# Model Settings
MODEL_PATH=                    # Path to fine-tuned model (optional)
BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.1
LOAD_IN_8BIT=true              # Use 8-bit quantization (saves VRAM)

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_KEY_REQUIRED=false         # Set to true for production

# Rate Limiting
RATE_LIMIT_REQUESTS=100        # Requests per window
RATE_LIMIT_WINDOW=3600         # Window in seconds (1 hour)

# Logging
LOG_LEVEL=info                 # debug, info, warning, error
ENABLE_WANDB=false             # Weights & Biases logging
WANDB_PROJECT=ethics-engine

# Development
DEBUG=false
RELOAD=false                   # Auto-reload on code changes
